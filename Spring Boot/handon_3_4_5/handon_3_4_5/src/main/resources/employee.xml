<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Date formatter helper -->
    <bean id="xmlDateFormat" class="java.text.SimpleDateFormat">
        <constructor-arg value="dd/MM/yyyy" />
    </bean>

    <!-- Departments -->
    <bean id="hr" class="com.example.springapi.model.Department">
        <property name="id" value="1"/>
        <property name="name" value="HR"/>
    </bean>

    <bean id="engineering" class="com.example.springapi.model.Department">
        <property name="id" value="2"/>
        <property name="name" value="Engineering"/>
    </bean>

    <bean id="product" class="com.example.springapi.model.Department">
        <property name="id" value="3"/>
        <property name="name" value="Product"/>
    </bean>

    <!-- Skills -->
    <bean id="java" class="com.example.springapi.model.Skill">
        <property name="id" value="1"/>
        <property name="name" value="Java"/>
    </bean>

    <bean id="springBoot" class="com.example.springapi.model.Skill">
        <property name="id" value="2"/>
        <property name="name" value="Spring Boot"/>
    </bean>

    <bean id="angular" class="com.example.springapi.model.Skill">
        <property name="id" value="3"/>
        <property name="name" value="Angular"/>
    </bean>

    <!-- Employees -->
    <bean id="emp1" class="com.example.springapi.model.Employee">
        <property name="id" value="1"/>
        <property name="name" value="John Doe"/>
        <property name="salary" value="55000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth">
            <bean factory-bean="xmlDateFormat" factory-method="parse">
                <constructor-arg value="31/12/1995"/>
            </bean>
        </property>
        <property name="department" ref="hr"/>
        <property name="skills">
            <list>
                <ref bean="java"/>
            </list>
        </property>
    </bean>

    <bean id="emp2" class="com.example.springapi.model.Employee">
        <property name="id" value="2"/>
        <property name="name" value="Jane Smith"/>
        <property name="salary" value="75000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth">
            <bean factory-bean="xmlDateFormat" factory-method="parse">
                <constructor-arg value="15/06/1990"/>
            </bean>
        </property>
        <property name="department" ref="engineering"/>
        <property name="skills">
            <list>
                <ref bean="java"/>
                <ref bean="springBoot"/>
            </list>
        </property>
    </bean>

    <bean id="emp3" class="com.example.springapi.model.Employee">
        <property name="id" value="3"/>
        <property name="name" value="Bob Johnson"/>
        <property name="salary" value="48000"/>
        <property name="permanent" value="false"/>
        <property name="dateOfBirth">
            <bean factory-bean="xmlDateFormat" factory-method="parse">
                <constructor-arg value="22/10/1998"/>
            </bean>
        </property>
        <property name="department" ref="product"/>
        <property name="skills">
            <list>
                <ref bean="angular"/>
            </list>
        </property>
    </bean>

    <bean id="emp4" class="com.example.springapi.model.Employee">
        <property name="id" value="4"/>
        <property name="name" value="Alice Williams"/>
        <property name="salary" value="82000"/>
        <property name="permanent" value="true"/>
        <property name="dateOfBirth">
            <bean factory-bean="xmlDateFormat" factory-method="parse">
                <constructor-arg value="05/03/1988"/>
            </bean>
        </property>
        <property name="department" ref="engineering"/>
        <property name="skills">
            <list>
                <ref bean="java"/>
                <ref bean="springBoot"/>
                <ref bean="angular"/>
            </list>
        </property>
    </bean>

    <!-- ArrayLists -->
    <bean id="employeeList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="emp1"/>
                <ref bean="emp2"/>
                <ref bean="emp3"/>
                <ref bean="emp4"/>
            </list>
        </constructor-arg>
    </bean>

    <bean id="departmentList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="hr"/>
                <ref bean="engineering"/>
                <ref bean="product"/>
            </list>
        </constructor-arg>
    </bean>

</beans>
