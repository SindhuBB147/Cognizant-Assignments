<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Hands-on-1 -->
    <bean id="country" class="com.example.springapi.model.Country">
        <property name="code" value="IN"/>
        <property name="name" value="India"/>
    </bean>

    <!-- Hands-on-2 and 3 -->
    <bean id="india" class="com.example.springapi.model.Country">
        <property name="code" value="IN"/>
        <property name="name" value="India"/>
    </bean>

    <bean id="usa" class="com.example.springapi.model.Country">
        <property name="code" value="US"/>
        <property name="name" value="United States"/>
    </bean>

    <bean id="japan" class="com.example.springapi.model.Country">
        <property name="code" value="JP"/>
        <property name="name" value="Japan"/>
    </bean>

    <bean id="germany" class="com.example.springapi.model.Country">
        <property name="code" value="DE"/>
        <property name="name" value="Germany"/>
    </bean>

    <bean id="countryList" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <ref bean="india"/>
                <ref bean="usa"/>
                <ref bean="japan"/>
                <ref bean="germany"/>
            </list>
        </constructor-arg>
    </bean>


</beans>